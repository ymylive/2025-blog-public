# Deployment credentials for deploy.py
VPS_HOST=your-vps-ip
VPS_USER=root
VPS_PASS=your-password
VPS_PORT=22
VPS_PATH=/www/wwwroot/2025-blog-public
APP_PORT=2025

# Clash (mihomo + MetaCubeXD) deployment
CLASH_CONFIG_URL=
CLASH_SECRET=
CLASH_DIR=/etc/mihomo
CLASH_UI_DIR=/etc/mihomo/metacubexd
CLASH_CONTROLLER_PORT=9090
CLASH_PROXY_PORT=7890
CLASH_ALLOW_LAN=false
